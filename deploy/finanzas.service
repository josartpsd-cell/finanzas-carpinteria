[Unit]
Description=Finanzas Carpinteria
After=network.target

[Service]
Type=simple
User=finanzas
Group=finanzas
WorkingDirectory=/opt/finanzas
Environment=NODE_ENV=production
Environment=PORT=4173
Environment=DATA_DIR=/opt/finanzas/data
Environment=UPLOAD_DIR=/opt/finanzas/uploads
EnvironmentFile=-/opt/finanzas/.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
StandardOutput=append:/var/log/finanzas.log
StandardError=append:/var/log/finanzas.log

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/finanzas/data /opt/finanzas/uploads

[Install]
WantedBy=multi-user.target
